{
  "manifest_version": 3,
  "name": "YouTube Focus",
  "version": "1.5",
  "description": "Remove Shorts, barra recomendações e força a página de inscrições.",
 
  "permissions": ["storage"],
  
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Configurações"
  },

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["redirecionar.js"],
      "css": ["limpeza.css"],
      "run_at": "document_start"
    }
  ]
}